# Copy this file to .env for local testing. On Render, set these as
# Environment Variables in the dashboard instead (don't upload .env there).

# Used to build full photo URLs (https://yourapp.onrender.com). Leave blank
# locally; Render sets its own URL, see README notes in the chat reply.
PUBLIC_URL=

# Paste the ENTIRE contents of your Firebase service account JSON file
# here as a single line (Project settings > Service accounts > Generate
# new private key). This does NOT require Blaze/a card — it's free.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Simple shared secret the ESP32 and app both send so random strangers
# can't post fake detections or read your photos. Make up any string.
API_KEY=change-this-to-your-own-secret
